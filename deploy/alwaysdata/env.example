# Copy to /home/<account>/sova/.env, replace every <account>, and chmod 600.
# This file intentionally contains no Ollama, Qwen, Codex CLI, or macOS paths.
SOVA_TIMEZONE=Europe/Moscow
SOVA_STATE_DIR=/home/<account>/sova/data/state
SOVA_DATABASE_PATH=/home/<account>/sova/data/state/sova.db
SOVA_SQLITE_JOURNAL_MODE=DELETE
SOVA_OVERVIEW_COOLDOWN=15m
SOVA_DAILY_RUN_TIME=08:00
SOVA_HEARTBEAT_PATH=/home/<account>/sova/data/state/health/heartbeat.json

# Dedicated MTProto project session; never upload Telegram Desktop tdata.
SOVA_TELEGRAM_APP_ID=
SOVA_TELEGRAM_APP_HASH=
SOVA_TELEGRAM_PHONE=
SOVA_TELEGRAM_SESSION_PATH=/home/<account>/sova/data/sessions/sova-user.json
SOVA_NEST_TELEGRAM_ALLOWED_CHATS=

SOVA_NEST_BOT_TOKEN=
SOVA_NEST_CHAT_ID=
SOVA_NEST_TOPIC_DIGEST_ID=
SOVA_NEST_TOPIC_CALENDAR_ID=
SOVA_NEST_TOPIC_STATUS_ID=
SOVA_NEST_TOPIC_CHAT_ID=
SOVA_NEST_GOOGLE_MODELS=gemini-3.5-flash-lite,gemma-4-31b-it,gemini-3.1-flash-lite,gemma-4-26b-a4b-it

SOVA_WORKSPACE_BOT_TOKEN=
SOVA_WORKSPACE_LEGACY_SOURCE=
SOVA_WORKSPACE_CHAT_ID=
SOVA_WORKSPACE_TOPIC_INBOX_ID=
SOVA_WORKSPACE_TOPIC_TASKS_ID=
SOVA_WORKSPACE_TOPIC_NOTES_ID=
SOVA_WORKSPACE_TOPIC_EXPERIENCE_ID=
SOVA_WORKSPACE_TOPIC_USEFUL_ID=
SOVA_WORKSPACE_TOPIC_TEMPLATES_ID=
SOVA_WORKSPACE_TOPIC_COLLECTIONS_ID=

SOVA_CONTROL_BOT_TOKEN=
SOVA_CONTROL_CHAT_ID=
SOVA_CONTROL_TOPIC_STATUS_ID=
SOVA_CONTROL_TOPIC_ERRORS_ID=
SOVA_CONTROL_TOPIC_RUNS_ID=
SOVA_CONTROL_TOPIC_REVIEW_ID=
SOVA_CONTROL_TOPIC_TEST_LAB_ID=
SOVA_CONTROL_TOPIC_WORKSPACE_ID=
SOVA_CONTROL_TOPIC_NEST_ID=
SOVA_CONTROL_TOPIC_IDEAS_ID=
SOVA_CONTROL_TOPIC_ARCHIVE_ID=

SOVA_GEMINI_API_KEY=
SOVA_GEMINI_MODEL=gemini-3.5-flash
SOVA_GEMINI_FALLBACK_MODEL_1=gemini-3-flash-preview
SOVA_GEMINI_FALLBACK_MODEL_2=gemini-3.1-flash-lite

SOVA_SEARCH_ENABLED=false
SOVA_SEARCH_LEGACY_CHAT_ID=
SOVA_SEARCH_EMBEDDING_MODEL=gemini-embedding-2
SOVA_SEARCH_FALLBACK_GEMINI_API_KEY=

SOVA_GOOGLE_CREDENTIALS_PATH=/home/<account>/sova/data/secrets/google-calendar-client.json
SOVA_GOOGLE_TOKEN_PATH=/home/<account>/sova/data/secrets/google-calendar-token.json
SOVA_GOOGLE_CALENDAR_ID=

# Configure these in Advanced -> Services. They are also defaulted by run-all.sh.
# GOMEMLIMIT=160MiB
# GOGC=75
